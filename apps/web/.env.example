HOST=127.0.0.1
PORT=4321
# The public URL of the CMS. Media URLs point at it, and the build reads it for image.remotePatterns.
# Required in production: astro build and the built server stop with an error without it.
PAYLOAD_URL=http://127.0.0.1:3000
# Optional: the public URL of the web app. Sets Astro's site, which og:url falls back to when a page
# has no canonical URL. Without it, og:url uses the request's origin, which is wrong behind a proxy.
# SITE_URL=https://www.example.com
DATABASE_URL=postgres://postgres@127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
# The end-to-end tests (pnpm test:e2e) read this file too. They run the CMS on DATABASE_URL's database
# with -e2e appended, which every run wipes with migrate:fresh and seeds again, and keep its uploads in
# a temporary MEDIA_DIR. Optional: the ports they run the CMS and the web app on.
# E2E_CMS_PORT=3100
# E2E_WEB_PORT=4400
