HOST=127.0.0.1
PORT=4321
# The public URL of the CMS. Media URLs point at it, and the build reads it for image.remotePatterns.
PAYLOAD_URL=http://127.0.0.1:3000
DATABASE_URL=postgres://postgres@127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
# Optional: the ports the end-to-end tests run the CMS and the web app on.
# E2E_CMS_PORT=3100
# E2E_WEB_PORT=4400
