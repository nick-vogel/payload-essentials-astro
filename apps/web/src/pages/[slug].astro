---
import Blocks from '../blocks/Blocks.astro'
import Base from '../layouts/Base.astro'
import { HOME_SLUG } from '../lib/links'
import { docMeta } from '../lib/meta'
import { findPage } from '../lib/pages'

const { slug } = Astro.params

// The home page renders at the root only, so /home points there for good.
if (slug === HOME_SLUG) return Astro.redirect('/', 301)

const page = slug ? await findPage(slug) : null

if (!page) return Astro.rewrite('/404')
---

<Base {...docMeta(page)}>
  <Blocks blocks={page.blocks} />
</Base>
