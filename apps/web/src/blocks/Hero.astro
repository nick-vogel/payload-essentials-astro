---
import { Image } from 'astro:assets'
import type { HeroBlockProps } from 'cms/types'
import Header from '../components/Header.astro'
import { pageHref } from '../lib/links'
import { isMedia, mediaFile } from '../lib/media'

type Props = HeroBlockProps

const { title, heroImage, showHeroImage, primaryCTA, secondaryCTA } = Astro.props
const ctas = [
  { page: primaryCTA, class: 'primaryCta' },
  { page: secondaryCTA, class: 'secondaryCta' },
].flatMap(({ page, class: className }) => (typeof page === 'object' && page ? [{ ...page, className }] : []))
const image = showHeroImage && isMedia(heroImage) ? mediaFile(heroImage, 'fullSize') : null
const alt = isMedia(heroImage) ? heroImage.alt : ''
---

<section class="hero">
  <div class="content">
    <Header as="h1" class="title">{title}</Header>
    {
      ctas.length > 0 && (
        <div class="ctaContainer">
          {ctas.map((cta) => (
            <a class={cta.className} href={pageHref(cta.slug)}>
              {cta.title}
            </a>
          ))}
        </div>
      )
    }
  </div>
  {
    image && (
      <>
        <div class="overlay" />
        <Image
          class="image"
          src={image.url}
          alt={alt}
          width={image.width}
          height={image.height}
          loading="eager"
          fetchpriority="high"
        />
      </>
    )
  }
</section>

<style>
  .hero {
    position: relative;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .content {
    position: relative;
    z-index: 2;
    padding: var(--space-8);
  }

  /* Two classes, so the hero title wins over the h1 styles in the Header component. */
  .content .title {
    color: var(--white);
    margin-top: 0;
    margin-bottom: var(--space-8);
    text-shadow: var(--shadow-sm);
    font-size: 2.5rem;
    line-height: 1;
    text-align: center;
    @media (min-width: 768px) {
      font-size: 3rem;
    }
  }

  .ctaContainer {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-direction: column;
    align-items: center;
    flex-wrap: wrap;
    @media (min-width: 768px) {
      flex-direction: row;
    }
  }

  .primaryCta, .secondaryCta {
    display: inline-block;
    padding: var(--space-4) var(--space-10);
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    cursor: pointer;
    width: 100%;
    max-width: 280px;
    text-align: center;
    border: 2px solid var(--white);
    @media (min-width: 768px) {
      width: auto;
      max-width: none;
    }
  }

  .primaryCta {
    background-color: var(--white);
    color: var(--black);
    box-shadow: var(--shadow-sm);

    &:hover {
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }
  }

  .secondaryCta {
    background-color: transparent;
    color: var(--white);

    &:hover {
      background-color: rgba(255, 255, 255, 0.1);
      transform: translateY(-2px);
    }
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.6) 0%,
      rgba(0, 0, 0, 0.4) 50%,
      rgba(0, 0, 0, 0.6) 100%
    );
    z-index: var(--z-content);
  }

  .image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
</style>
