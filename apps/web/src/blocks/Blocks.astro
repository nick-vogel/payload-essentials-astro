---
import type { Page } from 'cms/types'
import Cards from './Cards.astro'
import Hero from './Hero.astro'
import Text from './Text.astro'
import TextAndImage from './TextAndImage.astro'

type Props = { blocks: Page['blocks'] }

const { blocks } = Astro.props
---

{
  blocks?.map((block) => {
    switch (block.blockType) {
      case 'hero':
        return <Hero {...block} />
      case 'text':
        return <Text {...block} />
      case 'textAndImage':
        return <TextAndImage {...block} />
      case 'cards':
        return <Cards {...block} />
    }
  })
}
