---
type Props = {
  currentPage: number
  totalPages: number
  // The URL of a page, so the caller keeps its own params, such as the category, on every link.
  href: (page: number) => string
}

const { currentPage, totalPages, href } = Astro.props
const pages = Array.from({ length: totalPages }, (_, index) => index + 1)
const hasPrev = currentPage > 1
const hasNext = currentPage < totalPages
---

{
  totalPages > 1 && (
    <nav aria-label="Pagination" class="pagination">
      <ol class="list">
        <li>
          {hasPrev ? (
            <a href={href(currentPage - 1)} class="link arrow" aria-label="Previous page">
              Previous
            </a>
          ) : (
            <span class="link arrow disabled" aria-disabled="true">
              Previous
            </span>
          )}
        </li>
        {pages.map((page) => (
          <li>
            {page === currentPage ? (
              <span class="link active" aria-current="page">
                {page}
              </span>
            ) : (
              <a href={href(page)} class="link">
                {page}
              </a>
            )}
          </li>
        ))}
        <li>
          {hasNext ? (
            <a href={href(currentPage + 1)} class="link arrow" aria-label="Next page">
              Next
            </a>
          ) : (
            <span class="link arrow disabled" aria-disabled="true">
              Next
            </span>
          )}
        </li>
      </ol>
    </nav>
  )
}

<style>
  .pagination {
    margin-top: var(--space-8);
  }

  .list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 var(--space-3);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    color: light-dark(var(--black), var(--white));
    background: light-dark(var(--white), var(--black));
    box-shadow: var(--shadow-sm);
    transition: background var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);

    &:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-1px);
    }

    &:focus-visible {
      outline: 2px solid light-dark(var(--black), var(--white));
      outline-offset: 2px;
    }

    @media (max-width: 768px) {
      min-width: 2.25rem;
      height: 2.25rem;
      padding: 0 var(--space-2);
      font-size: 0.8125rem;
    }
  }

  .active {
    background: light-dark(var(--black), var(--white));
    color: light-dark(var(--white), var(--black));
    pointer-events: none;
  }

  .disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  .arrow {
    font-size: 0.8125rem;
    letter-spacing: 0.025em;

    @media (max-width: 768px) {
      font-size: 0.75rem;
    }
  }
</style>
