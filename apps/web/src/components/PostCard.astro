---
import type { PostPreviewData } from '../lib/cms'
import { postHref } from '../lib/links'
import Header from './Header.astro'
import MediaImage from './MediaImage.astro'
import PostMeta from './PostMeta.astro'

// The two cards of the Next.js site. The blog list uses the default card, with the category badge.
// The related posts use the compact card, with no badge, a lighter shadow and smaller type.
type Props = { post: PostPreviewData; variant?: 'default' | 'compact' }

const { post, variant = 'default' } = Astro.props
const { slug, title, featuredImage, category } = post
const categoryName = variant === 'default' && category && typeof category === 'object' ? category.name : null
---

{/* The title link stretches over the whole card, so the card is one link named by its title. */}
<article class:list={['card', variant]}>
  <div class="imageArea">
    {
      categoryName && (
        <span class="categoryBadge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
            <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
          </svg>
          {categoryName}
        </span>
      )
    }
    <MediaImage image={featuredImage} size="card" class="image" />
  </div>
  <div class="content">
    <Header as="h3" align="left"><a class="link" href={postHref(slug)}>{title}</a></Header>
    <div class="meta">
      <PostMeta post={post} />
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    background-color: light-dark(var(--white), var(--black));
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-medium), box-shadow var(--transition-medium);

    @media (min-width: 768px) {
      &:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
      }

      &:hover :global(img) {
        transform: scale(1.05);
      }
    }
  }

  .link {
    color: inherit;
    text-decoration: none;

    &::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: var(--z-content);
    }

    &:focus-visible {
      outline: none;
    }
  }

  .card:has(.link:focus-visible) {
    outline: 2px solid light-dark(var(--black), var(--white));
    outline-offset: 2px;
  }

  .imageArea {
    position: relative;
  }

  /* The card clips and shadows the image itself. */
  .image {
    margin-bottom: 0;
    border-radius: 0;
    box-shadow: none;

    :global(img) {
      transition: transform var(--transition-medium), filter var(--transition-medium);
    }
  }

  .categoryBadge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: var(--z-content);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background-color: var(--badge-background);
    color: var(--badge-text);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-6) var(--space-6);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    font-size: 0.875rem;
    color: light-dark(var(--dark-gray), var(--light-gray));

    /* The spans belong to PostMeta, so the rule reaches them through :global. */
    :global(span) {
      white-space: nowrap;
    }
  }

  .compact {
    box-shadow: var(--shadow-sm);

    @media (min-width: 768px) {
      &:hover {
        box-shadow: var(--shadow-md);
      }
    }

    .content {
      padding: var(--space-4);
    }

    .meta {
      font-size: 0.8125rem;
    }
  }
</style>
