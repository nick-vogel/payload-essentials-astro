---
import type { PostPreviewData } from '../lib/cms'

// The items of a post's meta row: the author, the category and the date. The parent renders the
// row itself, so each card keeps its own spacing and type size.
type Props = {
  post: Pick<PostPreviewData, 'populatedAuthor' | 'category' | 'date' | 'date_tz'>
  showCategory?: boolean
}

const { post, showCategory = false } = Astro.props
const { populatedAuthor: author, category, date, date_tz } = post
const categoryName = showCategory && category && typeof category === 'object' ? category.name : null
const formattedDate = date
  ? new Date(date).toLocaleString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: date_tz ?? undefined,
    })
  : null
---

{
  author?.name && (
    <span class="iconContainer">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="8" r="5" />
        <path d="M20 21a8 8 0 0 0-16 0" />
      </svg>
      {author.name}
    </span>
  )
}
{
  categoryName && (
    <span class="iconContainer">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z" />
        <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
      </svg>
      {categoryName}
    </span>
  )
}
{
  date && formattedDate && (
    <span class="iconContainer">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 2v4" />
        <path d="M16 2v4" />
        <rect width="18" height="18" x="3" y="4" rx="2" />
        <path d="M3 10h18" />
      </svg>
      <time datetime={date}>{formattedDate}</time>
    </span>
  )
}

<style>
  .iconContainer {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
</style>
