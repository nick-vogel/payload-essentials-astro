---
import { postHref } from '../lib/links'

type PostLink = { slug: string; title: string } | null

type Props = {
  previous: PostLink
  next: PostLink
}

const { previous, next } = Astro.props
---

{
  (previous || next) && (
    <nav class="nav" aria-label="Post navigation">
      <div class="inner">
        {previous ? (
          <a href={postHref(previous.slug)} class="link prev" aria-label={`Previous post: ${previous.title}`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 18-6-6 6-6" />
            </svg>
            <span class="linkContent">
              <span class="label">Previous Post</span>
              <span class="title">{previous.title}</span>
            </span>
          </a>
        ) : (
          <span />
        )}
        {next ? (
          <a href={postHref(next.slug)} class="link next" aria-label={`Next post: ${next.title}`}>
            <span class="linkContent">
              <span class="label">Next Post</span>
              <span class="title">{next.title}</span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </a>
        ) : (
          <span />
        )}
      </div>
    </nav>
  )
}

<style>
  .nav {
    padding: var(--space-8) 0;
    max-width: var(--container-max);
    margin: 0 auto;

    @media (min-width: 768px) {
      max-width: calc(var(--container-max) + var(--space-16));
    }

    @media (min-width: 1024px) {
      max-width: calc(var(--container-max) + var(--space-12) * 2);
    }
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: var(--space-6);
    padding: 0 var(--space-6);

    @media (min-width: 768px) {
      padding: 0 var(--space-8);
    }

    @media (min-width: 1024px) {
      padding: 0 var(--space-12);
    }

    @media (max-width: 500px) {
      flex-direction: column;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      padding: 0 var(--space-6);
    }
  }

  .link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid light-dark(var(--dark-gray), var(--light-gray));
    background: light-dark(var(--white), var(--black));
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
    max-width: 48%;

    &:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    &:focus-visible {
      outline: 2px solid light-dark(var(--black), var(--white));
      outline-offset: 2px;
    }

    @media (max-width: 768px) {
      max-width: 100%;
    }
  }

  .prev {
    margin-right: auto;

    @media (max-width: 500px) {
      justify-content: flex-start;
      width: 100%;
      margin-right: 0;
    }
  }

  .next {
    margin-left: auto;
    text-align: right;

    @media (max-width: 500px) {
      justify-content: flex-end;
      width: 100%;
      margin-left: 0;
    }
  }

  .linkContent {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: light-dark(var(--dark-gray), var(--light-gray));
  }

  .title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }
</style>
