---
import type { Post } from 'cms/types'
import { postHref } from '../lib/links'

// Links to the posts just before and after this one by date, as the Next.js site's PostNavigation did.
type PostLink = Pick<Post, 'slug' | 'title'> | null

type Props = {
  previous: PostLink
  next: PostLink
}

const { previous, next } = Astro.props

// Each side's chevron points outward, so it sits before the text on the left and after it on the right.
const sides = [
  { post: previous, label: 'Previous', class: 'prev', chevron: 'm15 18-6-6 6-6' },
  { post: next, label: 'Next', class: 'next', chevron: 'm9 18 6-6-6-6' },
]
---

{
  (previous || next) && (
    <nav class="nav" aria-label="Post navigation">
      <div class="inner">
        {sides.map(({ post, label, class: side, chevron }) => {
          if (!post) return <span />
          const icon = (
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={chevron} />
            </svg>
          )
          const text = (
            <span class="linkContent">
              <span class="label">{label} Post</span>
              <span class="title">{post.title}</span>
            </span>
          )
          return (
            <a href={postHref(post.slug)} class={`link ${side}`} aria-label={`${label} post: ${post.title}`}>
              {side === 'prev' ? [icon, text] : [text, icon]}
            </a>
          )
        })}
      </div>
    </nav>
  )
}

<style>
  .nav {
    padding: var(--space-8) 0;
    max-width: var(--container-max);
    margin: 0 auto;

    @media (min-width: 768px) {
      max-width: calc(var(--container-max) + var(--space-16));
    }

    @media (min-width: 1024px) {
      max-width: calc(var(--container-max) + var(--space-12) * 2);
    }
  }

  .inner {
    display: flex;
    justify-content: space-between;
    align-items: stretch;
    gap: var(--space-6);
    padding: 0 var(--space-6);

    @media (min-width: 768px) {
      padding: 0 var(--space-8);
    }

    @media (min-width: 1024px) {
      padding: 0 var(--space-12);
    }

    @media (max-width: 500px) {
      flex-direction: column;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      padding: 0 var(--space-6);
    }
  }

  .link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border: 1px solid light-dark(var(--dark-gray), var(--light-gray));
    background: light-dark(var(--white), var(--black));
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
    max-width: 48%;

    &:hover {
      box-shadow: var(--shadow-md);
      transform: translateY(-2px);
    }

    &:focus-visible {
      outline: 2px solid light-dark(var(--black), var(--white));
      outline-offset: 2px;
    }

    @media (max-width: 768px) {
      max-width: 100%;
    }
  }

  .prev {
    margin-right: auto;

    @media (max-width: 500px) {
      justify-content: flex-start;
      width: 100%;
      margin-right: 0;
    }
  }

  .next {
    margin-left: auto;
    text-align: right;

    @media (max-width: 500px) {
      justify-content: flex-end;
      width: 100%;
      margin-left: 0;
    }
  }

  .linkContent {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: light-dark(var(--dark-gray), var(--light-gray));
  }

  .title {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }
</style>
